# Weather Dashboard - Environment Example
# Copy this file to .env and set the values as needed.

# Base URL for your weather API proxy (e.g., https://api.example.com)
REACT_APP_API_BASE=

# Supabase (future integration)
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_KEY=

# Optional runtime toggles (if used by deployment)
REACT_APP_NODE_ENV=development
REACT_APP_LOG_LEVEL=info
